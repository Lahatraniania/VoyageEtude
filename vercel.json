{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/src/api/(.*)",
            "destination": "/src/api/index.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/src/index.html"
        }
    ]
}